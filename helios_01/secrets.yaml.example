# Copy to secrets.yaml and fill in. secrets.yaml is gitignored — never commit it.

# Shared across all devices
wifi_ssid: "YourNetwork"
wifi_password: "YourWiFiPassword"

# Per-device API encryption key.
# Generate a fresh one per device: openssl rand -base64 32
# (44 characters, ends in =)
helios_01_api_key: "PASTE_44_CHAR_BASE64_KEY_HERE"
